{
  "name": "makevideo",
  "version": "0.4.0",
  "description": "Fast, standard video generation for AI agents: JSON script in, narrated MP4 out. Text-to-video with a local neural voice (Kokoro TTS), auto-synced captions, slides, screenshots and gameplay clips, rendered to MP4 by ffmpeg. No browser, no API key, no cloud.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "makevideo": "bin/makevideo.js"
  },
  "files": [
    "src",
    "bin",
    "fonts",
    "schema.json",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "skills",
    "examples/*.json",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.js && node test/mcp.js",
    "example": "node bin/makevideo.js examples/showcase.json",
    "site": "node scripts/build-site.mjs"
  },
  "keywords": [
    "video",
    "video-generation",
    "text-to-video",
    "narration",
    "makevideo",
    "voiceover",
    "tts",
    "text-to-speech",
    "kokoro",
    "kokoro-tts",
    "ai-agent",
    "ai-agents",
    "agent-tools",
    "llm",
    "claude",
    "claude-code",
    "codex",
    "mcp",
    "explainer-video",
    "slideshow",
    "subtitles",
    "captions",
    "srt",
    "ffmpeg",
    "mp4",
    "canvas",
    "programmatic-video",
    "video-editing",
    "remotion-alternative",
    "shorts",
    "tiktok",
    "youtube",
    "devlog",
    "changelog-video",
    "demo-video",
    "markdown-to-video",
    "transitions",
    "kinetic-typography",
    "animated-charts",
    "piper",
    "piper-tts",
    "fast-tts",
    "cpu-only",
    "mcp-server",
    "model-context-protocol",
    "agents-md",
    "cursor",
    "copilot"
  ],
  "author": "Javier Roman Cruz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/random00000000/makevideo.git"
  },
  "homepage": "https://github.com/random00000000/makevideo#readme",
  "bugs": {
    "url": "https://github.com/random00000000/makevideo/issues"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.21.0",
    "phonemizer": "^1.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "marked": "^14.1.4"
  },
  "mcpName": "io.github.random00000000/makevideo"
}
