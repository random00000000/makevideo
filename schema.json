{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/random00000000/makevideo/schema.json",
  "title": "makevideo video spec",
  "type": "object",
  "required": [
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "format": {
      "enum": [
        "landscape",
        "16:9",
        "portrait",
        "9:16",
        "shorts",
        "square",
        "1:1",
        "720p"
      ]
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "fps": {
      "type": "integer",
      "default": 30
    },
    "theme": {
      "oneOf": [
        {
          "enum": [
            "midnight",
            "forge",
            "paper",
            "terminal"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "voice": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "const": false
        }
      ],
      "default": "af_heart"
    },
    "speed": {
      "type": "number",
      "default": 1
    },
    "brand": {
      "type": "string"
    },
    "captions": {
      "type": "boolean",
      "default": true
    },
    "captionStyle": {
      "enum": [
        "classic",
        "bold",
        "none"
      ]
    },
    "font": {
      "type": "string",
      "description": "installed font family or path to .ttf/.otf"
    },
    "progressBar": {
      "type": "boolean"
    },
    "music": {
      "type": "string",
      "description": "generated score (documentary | epic | wonder | tension | trailer) or an audio file path. Trailers cut on its beats."
    },
    "musicVolume": {
      "type": "number"
    },
    "pronounce": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "quality": {
      "enum": [
        "draft",
        "standard",
        "high"
      ]
    },
    "gif": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer"
            },
            "fps": {
              "type": "integer"
            },
            "start": {
              "type": "number"
            },
            "duration": {
              "type": "number"
            }
          }
        }
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "bullets",
              "chapter",
              "chart",
              "clip",
              "code",
              "compare",
              "cta",
              "decisions",
              "image",
              "logo",
              "outro",
              "quote",
              "slam",
              "split",
              "stat",
              "statement",
              "steps",
              "timeline",
              "title"
            ]
          },
          "say": {
            "type": "string",
            "description": "Narration for this scene. Scene length follows the audio."
          },
          "caption": {
            "type": "string",
            "description": "Override caption text"
          },
          "duration": {
            "type": "number",
            "description": "Minimum seconds (required when there is no say)"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "kicker": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlight": {
            "description": "code: line numbers / ranges; chart: label to highlight"
          },
          "src": {
            "type": "string",
            "description": "image (png/jpg/webp) or clip (mp4/webm/mov/gif), relative to the spec file"
          },
          "start": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "const": "auto"
              }
            ],
            "description": "clip: start time in the source (seconds), or \"auto\" for the most active window"
          },
          "fit": {
            "enum": [
              "cover",
              "contain"
            ]
          },
          "zoom": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "label": {
            "type": "string"
          },
          "countUp": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "left": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "right": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "transition": {
            "enum": [
              "auto",
              "push",
              "slide",
              "zoom",
              "wipe",
              "fade",
              "dip",
              "cut"
            ],
            "description": "transition INTO this scene"
          },
          "align": {
            "enum": [
              "center",
              "left"
            ]
          },
          "bars": {
            "description": "chart data: [{label, value}] or {label: value}",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            ]
          },
          "unit": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "search": {
            "type": "string",
            "description": "find a freely licensed image on Wikimedia Commons instead of src"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "number": {
            "type": "integer"
          },
          "pan": {
            "enum": [
              "in",
              "out",
              "left",
              "right",
              "up",
              "down"
            ]
          },
          "focus": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "[x, y] 0..1: part of the image kept in frame"
          },
          "credit": {
            "type": "string",
            "description": "attribution line shown on the image"
          },
          "beats": {
            "type": "integer",
            "minimum": 1,
            "description": "trailer: length in music beats (clip 4, slam 2, logo 8, cta 8 by default)"
          },
          "section": {
            "enum": [
              "intro",
              "build",
              "drop",
              "breakdown",
              "finale",
              "outro"
            ],
            "description": "trailer: part of the music this beat sits in (shapes the generated score)"
          },
          "speed": {
            "type": "number",
            "description": "clip playback speed (0.5 = slow motion)"
          },
          "ramp": {
            "type": "string",
            "description": "speed ramp \"from>to\", e.g. \"1>0.3\" (switches at 60%)"
          },
          "audio": {
            "type": "boolean",
            "description": "clip: false mutes its game audio in trailers"
          },
          "button": {
            "type": "string",
            "description": "cta: button text (default \"Wishlist on Steam\")"
          },
          "shot": {
            "type": "object",
            "description": "trailer clip filmed by `makevideo shoot`: { setup: JS run in the game, camera: \"orbit|push|dolly|fly|follow|hold ...\", wait, fps, mode: \"frames\"|\"realtime\" }",
            "properties": {
              "setup": {
                "type": "string"
              },
              "camera": {
                "type": "string"
              },
              "wait": {
                "type": "number"
              },
              "fps": {
                "type": "integer"
              },
              "mode": {
                "enum": [
                  "frames",
                  "realtime"
                ]
              }
            }
          }
        }
      }
    },
    "transition": {
      "enum": [
        "auto",
        "push",
        "slide",
        "zoom",
        "wipe",
        "fade",
        "dip",
        "cut"
      ],
      "default": "auto"
    },
    "style": {
      "enum": [
        "documentary",
        "history",
        "nature",
        "explainer",
        "trailer"
      ],
      "description": "whole look + score + package. \"trailer\": music-first Steam trailer cut on the beat"
    },
    "youtube": {
      "type": "boolean",
      "description": "also write .thumbnail.jpg and .description.txt (chapters + credits)"
    },
    "thumbnailText": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "bpm": {
      "type": "number",
      "description": "trailer: tempo of the generated score, or the exact tempo of your track (see `makevideo beats`)"
    },
    "musicOffset": {
      "type": "number",
      "description": "trailer: time of the first beat in your track, for exact sync"
    },
    "musicStart": {
      "type": "number",
      "description": "trailer: start the video near this time in your track (snapped to a downbeat)"
    },
    "gameAudio": {
      "type": "number",
      "description": "trailer: volume of each clip's own game audio under the music (0..1, default 0.35)"
    },
    "game": {
      "type": "string",
      "description": "trailer: command that starts your Electron game for `makevideo shoot` (default \"npm start\")"
    },
    "gameDir": {
      "type": "string",
      "description": "trailer: folder to run the game command in"
    }
  }
}
