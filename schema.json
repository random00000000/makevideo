{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/random00000000/makevideo/schema.json",
  "title": "makevideo video spec",
  "type": "object",
  "required": [
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "format": {
      "enum": [
        "landscape",
        "16:9",
        "portrait",
        "9:16",
        "shorts",
        "square",
        "1:1",
        "720p"
      ]
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "fps": {
      "type": "integer",
      "default": 30
    },
    "theme": {
      "oneOf": [
        {
          "enum": [
            "midnight",
            "forge",
            "paper",
            "terminal"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "voice": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "const": false
        }
      ],
      "default": "af_heart"
    },
    "speed": {
      "type": "number",
      "default": 1
    },
    "brand": {
      "type": "string"
    },
    "captions": {
      "type": "boolean",
      "default": true
    },
    "captionStyle": {
      "enum": [
        "classic",
        "bold",
        "none"
      ]
    },
    "font": {
      "type": "string",
      "description": "installed font family or path to .ttf/.otf"
    },
    "progressBar": {
      "type": "boolean"
    },
    "music": {
      "type": "string",
      "description": "generated score (documentary | epic | wonder | tension) or an audio file path"
    },
    "musicVolume": {
      "type": "number"
    },
    "pronounce": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "quality": {
      "enum": [
        "draft",
        "standard",
        "high"
      ]
    },
    "gif": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer"
            },
            "fps": {
              "type": "integer"
            },
            "start": {
              "type": "number"
            },
            "duration": {
              "type": "number"
            }
          }
        }
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "bullets",
              "chapter",
              "chart",
              "clip",
              "code",
              "compare",
              "decisions",
              "image",
              "outro",
              "quote",
              "split",
              "stat",
              "statement",
              "steps",
              "timeline",
              "title"
            ]
          },
          "say": {
            "type": "string",
            "description": "Narration for this scene. Scene length follows the audio."
          },
          "caption": {
            "type": "string",
            "description": "Override caption text"
          },
          "duration": {
            "type": "number",
            "description": "Minimum seconds (required when there is no say)"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "kicker": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlight": {
            "description": "code: line numbers / ranges; chart: label to highlight"
          },
          "src": {
            "type": "string",
            "description": "image (png/jpg/webp) or clip (mp4/webm/mov/gif), relative to the spec file"
          },
          "start": {
            "type": "number",
            "description": "clip start offset, seconds"
          },
          "fit": {
            "enum": [
              "cover",
              "contain"
            ]
          },
          "zoom": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "label": {
            "type": "string"
          },
          "countUp": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "left": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "right": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "transition": {
            "enum": [
              "auto",
              "push",
              "slide",
              "zoom",
              "wipe",
              "fade",
              "dip",
              "cut"
            ],
            "description": "transition INTO this scene"
          },
          "align": {
            "enum": [
              "center",
              "left"
            ]
          },
          "bars": {
            "description": "chart data: [{label, value}] or {label: value}",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            ]
          },
          "unit": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "search": {
            "type": "string",
            "description": "find a freely licensed image on Wikimedia Commons instead of src"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "number": {
            "type": "integer"
          },
          "pan": {
            "enum": [
              "in",
              "out",
              "left",
              "right",
              "up",
              "down"
            ]
          },
          "focus": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "[x, y] 0..1: part of the image kept in frame"
          },
          "credit": {
            "type": "string",
            "description": "attribution line shown on the image"
          }
        }
      }
    },
    "transition": {
      "enum": [
        "auto",
        "push",
        "slide",
        "zoom",
        "wipe",
        "fade",
        "dip",
        "cut"
      ],
      "default": "auto"
    },
    "style": {
      "enum": [
        "documentary",
        "history",
        "nature",
        "explainer"
      ],
      "description": "whole look + score + YouTube package"
    },
    "youtube": {
      "type": "boolean",
      "description": "also write .thumbnail.jpg and .description.txt (chapters + credits)"
    },
    "thumbnailText": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  }
}