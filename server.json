{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.random00000000/makevideo",
  "title": "makevideo",
  "description": "Narrated, captioned MP4 videos from Markdown or JSON. Local voice, CPU-only, no API key.",
  "repository": {
    "url": "https://github.com/random00000000/makevideo",
    "source": "github"
  },
  "websiteUrl": "https://random00000000.github.io/makevideo/",
  "version": "0.5.2",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/random00000000/makevideo:0.5.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-v",
          "value": "{workdir}:/work",
          "description": "Folder for your Markdown/JSON, media and the rendered MP4",
          "variables": {
            "workdir": {
              "description": "Absolute path of your project folder",
              "isRequired": true
            }
          }
        },
        {
          "type": "named",
          "name": "-w",
          "value": "/work"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}